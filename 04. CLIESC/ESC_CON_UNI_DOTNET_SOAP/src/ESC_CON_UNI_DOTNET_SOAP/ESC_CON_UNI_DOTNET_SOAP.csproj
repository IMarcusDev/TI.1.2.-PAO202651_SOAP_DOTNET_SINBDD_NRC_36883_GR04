<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ec.edu.monster</RootNamespace>
    <StartupObject>ec.edu.monster.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.1.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ESC_CON_UNI_DOTNET_SOAP.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dirección del servidor SOAP; se puede editar junto al .exe sin recompilar. -->
    <None Update="servidor.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>