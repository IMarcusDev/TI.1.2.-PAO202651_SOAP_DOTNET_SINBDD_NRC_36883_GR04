# Normalize all text files to LF in the repository
* text=auto eol=lf

# Windows-only scripts and Visual Studio solutions keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Binary files: never touch line endings
*.jar  binary
*.war  binary
*.dll  binary
*.exe  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
